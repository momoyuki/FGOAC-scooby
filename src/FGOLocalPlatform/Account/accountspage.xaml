<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.AccountsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,28,40,40" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock Text="Local accounts" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,24" Text="The accounts on this PC's own server. The Master menu on Play switches between them." />
      <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
        <TextBlock Text="In use" VerticalAlignment="Center" Margin="0,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
        <TextBlock Name="CurrentAccountText" Text="Loading..." Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="3" />
        <TextBlock Text="Card ending" VerticalAlignment="Center" Margin="14,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
        <TextBlock Name="CurrentAccessCodeText" Text="—" Foreground="{StaticResource ReadyBrush}" VerticalAlignment="Center" Margin="3" FontFamily="{StaticResource DigitFont}" FontSize="14" />
        <TextBlock Text="Select" VerticalAlignment="Center" Margin="14,3,6,3" Foreground="{StaticResource TextSoftBrush}" />
        <ComboBox Name="AccountComboBox" AutomationProperties.Name="Account" Width="330" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ToolTip="Local accounts: Master name, ID, level and mode" />
        <Button Name="UseAccountButton" Content="Use this account" />
        <Button Name="CreateAccountButton" Content="New Account" />
      </WrapPanel>
      <ItemsControl Name="AccountDetailsTable" Margin="0,0,0,20" AutomationProperties.Name="Account details">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <WrapPanel Margin="0,0,0,16">
        <Button Name="ResetAccountButton" Content="Reset to a New Account" Style="{StaticResource DangerButtonStyle}" />
        <Button Name="DeleteAccountButton" Content="Delete Account" IsEnabled="False" Style="{StaticResource DestructiveButtonStyle}" ToolTip="Permanently deletes the selected account: its save data, its card, card mappings and leftover backups" />
        <Button Name="RepairAccountButton" Content="Repair Past Results" ToolTip="Restores EXP, materials, Bond and Quest progress that an older version failed to save, from the results the game sent at the time" />
        <Button Name="GrantBenefitsButton" Content="Grant Items" IsEnabled="False" Style="{StaticResource GrantButtonStyle}" ToolTip="Pick currency or materials from the installed game data and add a chosen amount to the selected account" />
        <Button Name="RefreshAccountsButton" Content="Refresh" />
        <Button Name="SummonHistoryButton" Content="Summon results" IsEnabled="False" ToolTip="The account's recent summons and the card each one gave" />
        <TextBlock Name="CurrentSummonSummaryText" Text="Lv.1 - EXP 0 - 0 cards" FontSize="14" Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" Margin="8,3,3,3" />
      </WrapPanel>
      <TextBlock Name="AccountStatusText" Visibility="Collapsed" Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource IceBrush}" Margin="0,0,0,16" />
      <StackPanel Name="AccountTransferPanel" Visibility="Collapsed" Margin="0,8,0,16">
        <TextBlock Text="Move accounts" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" Text="Export all writes every local account to one .fgoaccounts.json file: its card, its whole save and its pending gifts. Import shows what it replaces before it writes, and backs everything up first. Cloud23333's launcher reads and writes the same files." />
        <WrapPanel>
          <Button Name="ExportAccountsButton" Content="Export all" />
          <Button Name="ImportAccountsButton" Content="Import" />
        </WrapPanel>
      </StackPanel>
      <TextBlock Text="One-Click Inventory and Growth" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,8" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" Text="These act on the selected account. Quit the game and stop the server first. The growth options only affect Servants the account already owns." />
      <WrapPanel Name="AccountUpgradePanel" IsEnabled="False" HorizontalAlignment="Left">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Width" Value="246" />
              <Setter Property="Margin" Value="0,0,10,10" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Button Content="Grant All Servants" Tag="servants" ToolTip="Tops every Servant card up to 5 copies through the normal print flow. Cards you already have more than 5 of are left alone, and running it again adds nothing." />
        <Button Content="Grant All Craft Essences" Tag="craft-essences" ToolTip="Tops every Craft Essence card up to 5 copies. Cards you already have more than 5 of are left alone, and running it again adds nothing." />
        <Button Content="Clear Present Box" Tag="clear-gifts" ToolTip="Deletes every unclaimed present without claiming it. The claim and delete history is kept, and the account is backed up first." />
        <Button Content="Clear All Quests" Tag="quests" ToolTip="Marks every Quest cleared and every Master Mission complete. You still claim the rewards yourself." />
        <Button Content="Max All Bond" Tag="bond" />
        <Button Content="Unlock All Costumes" Tag="costumes" />
        <Button Content="Max All Materials" Tag="materials" ToolTip="Fills every enhancement material in the installed data to its own cap" />
        <Button Content="Max All Servants" Tag="levels" ToolTip="Raises level, Ascension, level cap, Skills, support Skills, Noble Phantasm and Bond to the highest value available" />
        <Button Content="Max Master Level" Tag="master" ToolTip="Sets the Master's EXP to the top of the game's level table. Nothing else on the account changes." />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
