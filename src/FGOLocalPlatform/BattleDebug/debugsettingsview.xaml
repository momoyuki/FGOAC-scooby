<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.DebugSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Local battle debug presets. Everything is off by default and nothing is written to your account save." Style="{StaticResource HelpTextStyle}" Margin="0,0,0,4" />
      <TextBlock Text="Online play ignores them: Play Online always starts with every switch off." Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" />
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="12" Margin="0,0,0,18">
        <TextBlock Text="A running game takes the changes about a second after you save." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      </Border>
      <TextBlock Text="Cheats" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
      <StackPanel>
            <CheckBox Name="OneHit" Content="Fixed Damage 999999" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Every hit you land deals exactly 999999 damage; your listed ATK is not changed, and turning this off restores normal damage." Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
            <CheckBox Name="AttackStun" Content="Attacks Cause Stun" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Landing a hit asks the game for its own stun; immunity, recovery intervals and the normal wear-off rules all still apply. Guarded and missed attacks do not trigger it." Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
            <CheckBox Name="FullNp" Content="Keep NP Full" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Holds your Servant at the highest NP charge currently available, and refills it after you use it." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="InstantNoble" Content="Instant Noble Phantasm" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Skips the Noble Phantasm charge-up wait; the NP cutscene and the normal damage calculation are unchanged." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="Invincible" Content="Invincible" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Enemy attacks no longer take your HP; scripted story defeats still happen, and enemies themselves are not changed." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="StopTimer" Content="Stop the battle timer" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Name="StopTimerHookNote" Text="This game folder has an older update from Cloud23333, which ignores this setting; his latest update reads it." Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="24,0,0,4" Visibility="Collapsed" />
            <TextBlock Text="The battle's countdown stops while this is on." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
      </StackPanel>
      <StackPanel Name="HisSwitchesPanel" Visibility="Collapsed">
        <TextBlock Text="Quests and Versus" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,10" />
        <CheckBox Name="AutoClear" Content="Clear Quests on Entry" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
        <TextBlock Text="Single-player quests only. Each wave is cleared as soon as its battle starts, with the normal scenes and results; mission conditions such as kills or damage are not filled in." Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
        <CheckBox Name="Cost233" Content="Party Cost Limit 233" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
        <TextBlock Text="Turning it off brings back the normal limit for your Master level." Style="{StaticResource HelpTextStyle}" Margin="24,0,0,14" />
        <CheckBox Name="PvpSelect" Content="Pick the Versus Map" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
        <TextBlock Text="The map for ranked versus and solo versus against NPCs, used the next time you enter one in the game. Story, event and co-op battles keep their own maps." Style="{StaticResource HelpTextStyle}" Margin="24,0,0,8" />
        <ComboBox Name="PvpStage" Width="360" HorizontalAlignment="Left" Margin="24,0,0,0" MaxDropDownHeight="360" AutomationProperties.Name="Versus map" SelectionChanged="PvpStage_OnChanged" />
        <Image Name="PvpPreview" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="24,10,0,4" />
      </StackPanel>
      <WrapPanel Margin="0,18,0,12">
        <Button Content="Save" Width="150" Margin="0,0,8,0" Click="Save_OnClick" />
        <Button Content="Turn All Off" Width="150" Click="DisableAll_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" Style="{StaticResource HelpTextStyle}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>