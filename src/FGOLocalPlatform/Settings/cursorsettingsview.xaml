<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.CursorSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <StackPanel Margin="0,4" MaxWidth="900" HorizontalAlignment="Left">
    <WrapPanel Margin="0,0,0,4">
      <TextBlock Text="Tap with" VerticalAlignment="Center" Margin="0,3,8,3" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="TapButton" Width="220" AutomationProperties.Name="Tap with" SelectionChanged="TapButton_OnChanged" />
    </WrapPanel>
    <TextBlock Name="TapHookNote" Text="This game folder has an older update from Cloud23333, which ignores this setting; his latest update reads it." Style="{StaticResource HelpTextStyle}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,4" Visibility="Collapsed" />
    <TextBlock Name="TapStatus" Text="The mouse button that touches the screen in the game. Saved at once; used the next time the game starts." Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" />
    <TextBlock Text="Mouse Pointer and Inverted Outline" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
    <TextBlock Text="Replaces the crosshair pointer inside the game. These settings are saved on their own and take effect the next time the game starts." Style="{StaticResource HelpTextStyle}" />
    <WrapPanel Margin="0,8">
      <ComboBox Name="Mode" AutomationProperties.Name="Pointer" Width="170" SelectedIndex="0" SelectionChanged="Settings_OnChanged">
        <ComboBoxItem Content="Default Crosshair" />
        <ComboBoxItem Content="System Arrow" />
        <ComboBoxItem Content="Custom Image" />
      </ComboBox>
      <Button Content="Choose Image..." Margin="8,0" Click="Choose_OnClick" />
    </WrapPanel>
    <TextBlock Name="ImageName" Text="Supports PNG with transparency, JPG and BMP. The image is copied into the game folder, so it keeps working if you move the installation." Style="{StaticResource HelpTextStyle}" />
    <Grid Margin="0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Name="PreviewBorder" Width="132" Height="132" Margin="0,0,8,0" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Top">
        <Grid>
          <Image Name="Preview" Stretch="None" />
          <Canvas IsHitTestVisible="False">
            <Ellipse Name="Hotspot" Width="5" Height="5" Fill="{StaticResource IceBrush}" Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
          </Canvas>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=Size: {0:0} px}" />
        <Slider Name="SizeSlider" AutomationProperties.Name="Pointer size" Minimum="16" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
        <StackPanel Name="OutlinePanel">
          <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=OutlineSlider, Path=Value, StringFormat=Inverted outline: {0:0} px (0 turns it off)}" />
          <Slider Name="OutlineSlider" AutomationProperties.Name="Inverted outline" Minimum="0" Maximum="6" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
          <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="The outline inverts the colors of whatever is behind it, in real time. The preview uses a dark checkerboard; the pointer itself keeps the image colors, and transparent areas are cut away along the outline." TextWrapping="Wrap" Margin="0,8" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <StackPanel Name="HotspotPanel">
      <TextBlock Text="The pink dot marks where a click actually lands. The hotspot is set as a percentage of the pointer canvas: 50% is the center, 0% is the top left corner." Style="{StaticResource HelpTextStyle}" />
      <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=HotX, Path=Value, StringFormat=Hotspot X: {0:0}%}" />
      <Slider Name="HotX" AutomationProperties.Name="Hotspot X" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
      <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding ElementName=HotY, Path=Value, StringFormat=Hotspot Y: {0:0}%}" />
      <Slider Name="HotY" AutomationProperties.Name="Hotspot Y" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
    </StackPanel>
    <Button Content="Save Pointer Settings" HorizontalAlignment="Left" Margin="0,8" Click="Save_OnClick" />
    <TextBlock Name="Status" Foreground="{StaticResource IceBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>